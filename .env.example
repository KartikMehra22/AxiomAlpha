# AxiomAlpha — environment variables
#
# Copy this file to `.env` and fill in your keys. The repo's `.gitignore`
# excludes `.env`, so secrets stay local.
#
# Usage in a notebook / script:
#     from dotenv import load_dotenv
#     load_dotenv()
#     import os
#     fred_key = os.environ["FRED_API_KEY"]
#
# Or simply: `export FRED_API_KEY=...` before launching jupyter.

# --- FRED (NB01_data_pipeline) -------------------------------------------
# Required for the macroeconomic factor downloads (VIX, SP500, TNX, etc.).
# Free key from https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# --- yfinance (NB01_data_pipeline) ---------------------------------------
# yfinance is keyless. No env var required. yfinance is non-deterministic
# across calls (split-adjustment backfills, etc.) — that's why
# `scripts/check_determinism.py` skips NB01 and starts from NB02.

# --- HuggingFace (NB08_nlp_sentiment, NB09_rag_setup) --------------------
# Optional — only needed if you hit gated models or rate limits.
# Token from https://huggingface.co/settings/tokens
# HUGGINGFACE_HUB_TOKEN=
