# --- Generated pipeline data (regenerated by `python run_all.py`) -------
# Raw downloads from yfinance / FRED:
data/raw/prices.csv
data/raw/macro.csv
data/raw/synthetic_news.csv
# Processed artifacts (CSV + binary):
data/processed/*.csv
data/processed/*.pkl
data/processed/*.npy
data/processed/*.bin
data/processed/*.joblib
data/processed/*.parquet

# Keep small static config files that ARE checked in:
!data/raw/sector_map.json

# Output figures ARE tracked — the README and final_report.md reference them
# directly, so we want them visible without re-running the pipeline.
# (No data/outputs/*.png ignore rule on purpose.)

# --- Jupyter ---
.ipynb_checkpoints/
**/.ipynb_checkpoints/
__pycache__/
**/__pycache__/
*.pyc
*.pyo

# --- OS ---
.DS_Store
Thumbs.db

# --- Secrets / environment ---
.env
.env.*
!.env.example
secrets/
credentials*
*.pem
*.key

# --- Virtual envs ---
venv/
.venv/
env/

# --- IDE / tooling ---
.vscode/
.idea/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Orphan dir created by an earlier NB01 save cell that used the wrong relative
# path. The cell has been removed; this rule is belt-and-braces.
notebooks/data/

